    <node id="Safety Practices">
      <data key="d0">Safety Practices</data>
      <data key="d1">concept</data>
      <data key="d2">Safety practices in Claude Code include verifying external GitHub links, restricting Claude access to sensitive folders, and reviewing edits when necessary.</data>
