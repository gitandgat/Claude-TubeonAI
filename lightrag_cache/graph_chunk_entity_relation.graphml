    <node id="Pro/Max Subscription">
      <data key="d0">Pro/Max Subscription</data>
      <data key="d1">concept</data>
      <data key="d2">Pro/Max are Claude subscription plans recommended for heavy users to manage token costs more efficiently compared to pay-per-token pricing.</data>
