    <node id="Ask Before Edits">
      <data key="d0">Ask Before Edits</data>
      <data key="d1">method</data>
      <data key="d2">Ask before edits is a permissions mode in which Claude requests confirmation before making any file edits, providing an intermediate level of safety between plan mode and bypass permission.</data>
      <data key="d3">chunk-ab74c3d2ad783400aacdc12951dd5004</data>
