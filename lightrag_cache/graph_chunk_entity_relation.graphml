    <node id="Repo">
      <data key="d0">Repo</data>
      <data key="d1">artifact</data>
      <data key="d2">A repo (repository) is a project folder that holds code, files, and settings, used for organizing and versioning project content.&lt;SEP&gt;A repo (repository) is a project folder that holds code, files, and settings, used as the workspace unit in Claude Code.</data>
      <data key="d3">chunk-025a86a4903e4e489cd42bedaffcb840&lt;SEP&gt;chunk-ab74c3d2ad783400aacdc12951dd5004</data>
      <data key="d4">unknown_source</data>
