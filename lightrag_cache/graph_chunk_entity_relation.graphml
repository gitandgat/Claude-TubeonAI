      <data key="d13" />
    </edge>
    <edge source="Claude" target="Checkpoints And Undo">
      <data key="d7">3.0</data>
      <data key="d8">Claude auto-saves states via checkpoints and allows users to undo changes, providing safety during file modification.&lt;SEP&gt;Claude auto-saves changes using checkpoints and allows users to undo and revert to previous versions.&lt;SEP&gt;Claude Code auto-saves via checkpoints and allows users to undo changes, providing a safety mechanism during development.</data>
      <data key="d9">file management,safety,version control</data>
      <data key="d10">chunk-025a86a4903e4e489cd42bedaffcb840&lt;SEP&gt;chunk-ab74c3d2ad783400aacdc12951dd5004&lt;SEP&gt;chunk-1694023022122e91d5653a390a57c8f6</data>
