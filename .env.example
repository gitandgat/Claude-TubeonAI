# API Keys for Third-party Services

# TubeonAI API
TUBEONAI_API_KEY=your_tubeonai_api_key_here

# Email and Automation
ENCHARGE_API_KEY=your_encharge_api_key_here

# LLM and AI Services
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Vector/Embedding Services
VOYAGE_API_KEY=your_voyage_api_key_here
VOISPARK_API_KEY=your_voispark_api_key_here

# Content and Marketing
SENDPILOT_API_KEY=your_sendpilot_api_key_here
ZERNIO_API_KEY=your_zernio_api_key_here

# Multica Workspace Configuration
MULTICA_API_TOKEN=your_multica_api_token_here
MULTICA_WORKSPACE_ID=your_multica_workspace_id_here

# Job Pilot — Telegram front-end for ottawa-job-agent (ottawa-job-agent/telegram_bot.py).
# Create the bot via @BotFather (/newbot) to get the token; get your numeric user id
# from @userinfobot. The allowlist ensures only Sahawat's Telegram account can trigger
# tools that touch the live pipeline (run it, change tracker status, toggle auto-submit).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_numeric_user_id_here

# Workout bot (workout-agent/) — a THIRD, separate token. Telegram allows one
# long-poller per token, so reusing TELEGRAM_BOT_TOKEN or the nutrition token
# would 409 a running bot off the air. Register a new bot with @BotFather.
TELEGRAM_WORKOUT_BOT_TOKEN=your_workout_bot_token_here

# Longevity-Nutrition Supabase (live project afscqhevcuxovbxdyhop), used by
# workout-agent/. The service_role key is required, not the anon key: every RLS
# policy on the workout tables keys on auth.uid(), so the anon role reads back an
# empty list instead of erroring. Note VITE_SUPABASE_URL above points at an older,
# dead project; workout-agent refuses to use it.
SUPABASE_URL=https://afscqhevcuxovbxdyhop.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Printed by `python3 workout.py --init`; the user_profiles row workouts.user_id references.
WORKOUT_USER_ID=your_workout_user_uuid_here

# Ottawa job agent — Workday candidate account (ottawa-job-agent/workday_applier.py).
# No credentials here on purpose: Sahawat signs in himself in a real browser window
# via `python3 ottawa-job-agent/workday_session.py <tenant>` (e.g. goodlifefitness),
# and only the resulting session cookies are saved locally — his password never
# touches this codebase. A tenant with no saved (or an expired) session degrades to
# a prefilled application package instead of failing the run.

# Financial Data APIs
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Trading and Market APIs
MASSIVE_API_KEY=your_massive_api_key_here
ALLTICK_API_KEY=your_alltick_api_key_here

# Alpaca Trading API (multiple keys for different accounts)
ALPACA_API_KEY=your_alpaca_api_key_primary
ALPACA_SECRET_KEY=your_alpaca_secret_key_primary
ALPACA_API_KEY_B=your_alpaca_api_key_secondary
ALPACA_SECRET_KEY_B=your_alpaca_secret_key_secondary
ALPACA_API_KEY_C=your_alpaca_api_key_tertiary
ALPACA_SECRET_KEY_C=your_alpaca_secret_key_tertiary
