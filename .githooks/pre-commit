#!/bin/sh
# Blocks commits containing secrets, using gitleaks against staged changes.
# Setup (one-time per clone): git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "[pre-commit] gitleaks not installed (brew install gitleaks) — skipping secret scan" >&2
    exit 0
fi
gitleaks protect --staged --verbose --redact
status=$?
if [ $status -ne 0 ]; then
    echo "[pre-commit] BLOCKED: gitleaks detected a likely secret in staged changes." >&2
    echo "[pre-commit] Fix the finding above, or if it's a false positive add it to .gitleaks.toml" >&2
    exit 1
fi
exit 0
