# ── Alpaca Trading ───────────────────────────────────────────────────────────
# Get your keys at https://app.alpaca.markets → Settings → API Keys
# Use PAPER keys for testing; live keys for real money.

# Production Bot (minervini_bot.py)
ALPACA_API_KEY=your_alpaca_api_key_primary
ALPACA_SECRET_KEY=your_alpaca_secret_key_primary

# Bot B - Adaptive Parameter Tuning (bot_b.py)
ALPACA_API_KEY_B=your_alpaca_api_key_secondary
ALPACA_SECRET_KEY_B=your_alpaca_secret_key_secondary

# Bot C - Hybrid Position Sizing (bot_c.py)
ALPACA_API_KEY_C=your_alpaca_api_key_tertiary
ALPACA_SECRET_KEY_C=your_alpaca_secret_key_tertiary

# ── Massive.com / Polygon.io ─────────────────────────────────────────────────
# Sign up at https://polygon.io (or via massive.com)
# Free tier: 5 API calls/min, end-of-day data only — sufficient for this bot.
MASSIVE_API_KEY=your_polygon_api_key_here

# ── Paper Trading Flag ───────────────────────────────────────────────────────
# Keep this "true" until you are fully confident in live trading.
# Change to "false" only when using LIVE Alpaca keys.
PAPER_TRADING=true
