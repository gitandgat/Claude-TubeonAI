# ── Alpaca Trading ───────────────────────────────────────────────────────────
# Get your keys at https://app.alpaca.markets → Settings → API Keys
# Use PAPER keys for testing; live keys for real money.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ── Massive.com / Polygon.io ─────────────────────────────────────────────────
# Sign up at https://polygon.io (or via massive.com)
# Free tier: 5 API calls/min, end-of-day data only — sufficient for this bot.
MASSIVE_API_KEY=your_polygon_api_key_here

# ── Paper Trading Flag ───────────────────────────────────────────────────────
# Keep this "true" until you are fully confident in live trading.
# Change to "false" only when using LIVE Alpaca keys.
PAPER_TRADING=true
